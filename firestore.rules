rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // RELATIONAL CHECK: Is user a member of the team?
    function isTeamMember(teamId) {
      return isSignedIn() && exists(/databases/$(database)/documents/memberships/$(teamId + '_' + request.auth.uid));
    }

    function canAccessProject(data) {
      return isOwner(data.userId) || (data.teamId != null && isTeamMember(data.teamId));
    }

    function canAccessTask(data) {
      return isOwner(data.userId) || (data.projectId != null && canAccessProject(get(/databases/$(database)/documents/projects/$(data.projectId)).data));
    }

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    match /teams/{teamId} {
      allow get: if isTeamMember(teamId);
      allow create: if isSignedIn();
      allow update: if isTeamMember(teamId) && (get(/databases/$(database)/documents/memberships/$(teamId + '_' + request.auth.uid)).data.role == 'Owner' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    match /memberships/{membershipId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (get(/databases/$(database)/documents/memberships/$(incoming().teamId + '_' + request.auth.uid)).data.role == 'Owner' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
      allow delete: if isSignedIn(); 
    }

    match /projects/{projectId} {
      allow list, get: if isSignedIn() && canAccessProject(resource.data);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && canAccessProject(resource.data);
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    match /tasks/{taskId} {
      allow list, get: if isSignedIn() && canAccessTask(resource.data);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && canAccessTask(resource.data);
      allow delete: if isSignedIn() && canAccessTask(resource.data);
    }

    match /notes/{noteId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
